{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Week04：文档加载与切分（无需 Key）",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/week04/src/index.ts",
      "args": ["${input:week04Docs}", "${input:week04MaxChars}"],
      "cwd": "${workspaceFolder}/week04",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "windows": { "runtimeExecutable": "${env:APPDATA}/nvm/v24.19.0/node.exe" }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Week03：重复调用演示（无需 Key）",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/week03/src/run-agent.ts",
      "args": ["--demo-repeated"],
      "cwd": "${workspaceFolder}/week03",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "windows": { "runtimeExecutable": "${env:APPDATA}/nvm/v24.19.0/node.exe" }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Week03：错误恢复演示（无需 Key）",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/week03/src/run-agent.ts",
      "args": ["--demo-recovery"],
      "cwd": "${workspaceFolder}/week03",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "windows": {
        "runtimeExecutable": "${env:APPDATA}/nvm/v24.19.0/node.exe"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "cwd": "${workspaceFolder}/week03",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "windows": {
        "runtimeExecutable": "${env:APPDATA}/nvm/v24.19.0/node.exe"
      },
      "name": "Week03：Agent 演示（无需 Key）",
      "program": "${workspaceFolder}/week03/src/run-agent.ts",
      "args": [
        "--demo"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "cwd": "${workspaceFolder}/week03",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "windows": {
        "runtimeExecutable": "${env:APPDATA}/nvm/v24.19.0/node.exe"
      },
      "name": "Week03：Agent 真实模型（消耗 API 额度）",
      "program": "${workspaceFolder}/week03/src/run-agent.ts",
      "args": [
        "${input:agentQuestion}"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "cwd": "${workspaceFolder}/week03",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "windows": {
        "runtimeExecutable": "${env:APPDATA}/nvm/v24.19.0/node.exe"
      },
      "name": "Week03：本地知识服务",
      "program": "${workspaceFolder}/week03/src/serve.ts"
    }
  ],
  "inputs": [
    {
      "id": "week04Docs",
      "type": "promptString",
      "description": "资料目录（相对于 week04，例如 docs 或 ../week03）",
      "default": "docs"
    },
    {
      "id": "week04MaxChars",
      "type": "promptString",
      "description": "每块最大字符数（1～10000；50 方便观察长度切分）",
      "default": "50"
    },
    {
      "id": "agentQuestion",
      "type": "promptString",
      "description": "输入交给 Agent 的问题",
      "default": "请使用计算器计算 6 乘 7"
    }
  ]
}
