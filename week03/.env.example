# 手动工具命令和 agent:demo 不需要配置；仅 pnpm agent 读取本目录 .env。
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
# 填写账户中支持 Chat Completions function calling 的模型名称
MODEL_NAME=
MODEL_TIMEOUT_MS=30000
MODEL_MAX_OUTPUT_TOKENS=1000
# OpenAI 使用 max_completion_tokens；其他服务按其文档配置 max_tokens。
MODEL_TOKEN_PARAMETER=max_completion_tokens
# 包含最终回答在内的模型请求次数上限
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
